#!/bin/sh
# Strip Co-authored-by and tooling attribution trailers from a commit message file.
set -e
msg_file="$1"
if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
  exit 0
fi
tmp="${msg_file}.tmp"
grep -v -E -i \
  -e '^[[:space:]]*Co-authored-by:' \
  -e '^[[:space:]]*Made-with:' \
  -e '^[[:space:]]*Made with ' \
  -e '^[[:space:]]*Generated by' \
  -e '^[[:space:]]*🤖' \
  "$msg_file" > "$tmp"
# Drop trailing blank lines left after stripping trailers.
while [ -s "$tmp" ] && [ "$(tail -n 1 "$tmp")" = "" ]; do
  # POSIX: remove last line if empty
  sed '$d' "$tmp" > "${tmp}.2"
  mv "${tmp}.2" "$tmp"
done
mv "$tmp" "$msg_file"
