#!/bin/sh
# Block a push if any outgoing commit contains a Co-authored-by (or similar) trailer.
set -e
zero="0000000000000000000000000000000000000000"

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha"
  else
    range="${remote_sha}..${local_sha}"
  fi
  if git log --format='%B' "$range" 2>/dev/null | grep -E -i -q \
    -e '^[[:space:]]*Co-authored-by:' \
    -e '^[[:space:]]*Made-with:' \
    -e '^[[:space:]]*Made with ' \
    -e 'Made with Cursor' \
    -e 'Made with \[Cursor\]' \
    -e '^[[:space:]]*Generated by'; then
    echo "pre-push: refused — a commit in this push contains a Co-authored-by (or tooling) trailer." >&2
    echo "Strip it, then push again. Do not keep those trailers." >&2
    exit 1
  fi
done

if ! pnpm format:check; then
  echo "pre-push: refused — pnpm format:check failed (CI quality job)." >&2
  echo "Run: pnpm format" >&2
  echo "Commit the result, then push again. Do not use --no-verify." >&2
  exit 1
fi

root="$(git rev-parse --show-toplevel)"
if [ -x "$root/.githooks/ensure-github-issue" ]; then
  "$root/.githooks/ensure-github-issue"
else
  echo "pre-push: missing .githooks/ensure-github-issue" >&2
  exit 1
fi

if [ -z "$CI" ] && command -v gh >/dev/null 2>&1; then
  pr_n="$(gh pr view --json number --jq .number 2>/dev/null || true)"
  if [ -n "$pr_n" ] && [ -x "$root/.github/scripts/sync-project-status.sh" ]; then
    if ! "$root/.github/scripts/sync-project-status.sh" "$pr_n"; then
      echo "pre-push: warning — could not sync issue assignment or board status." >&2
    fi
  fi
fi

exit 0
