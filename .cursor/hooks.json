{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/install-git-hooks.sh"
      }
    ],
    "afterShellExecution": [
      {
        "command": ".cursor/hooks/strip-commit-trailers.sh"
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/block-coauthor-push.sh"
      }
    ]
  }
}
