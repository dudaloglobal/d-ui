{
  "name": "dudalo-design-system",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Dudalo Design System (DudaX) — package d-ui",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "test:e2e": "bun run --filter @dudaloglobal/d-ui test:e2e",
    "build": "bun run --filter @dudaloglobal/d-ui build && bun run --filter @dudaloglobal/d-ui-education build",
    "build-storybook": "bun run --filter @dudaloglobal/d-ui build-storybook",
    "storybook": "bun run --filter @dudaloglobal/d-ui storybook",
    "changeset": "changeset",
    "prepare": "sh .githooks/install.sh",
    "version-packages": "changeset version && bun install --lockfile-only --ignore-scripts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-storybook": "10.5.10",
    "globals": "^17.11.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0"
  }
}
